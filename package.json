{
  "name": "bleach-like",
  "private": true,
  "version": "0.1.0",
  "description": "REISHI — a Bleach fan game: destructible voxel world, every character's full kit (Three.js).",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "shots": "node tools/shots/shoot.mjs",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@fontsource/dela-gothic-one": "5.3.0",
    "@fontsource/yuji-syuku": "5.3.0",
    "@fontsource/zen-kaku-gothic-new": "5.3.0",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "0.186.0",
    "playwright-core": "1.56.1",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
